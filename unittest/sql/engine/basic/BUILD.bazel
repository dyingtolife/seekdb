cc_test(
    name = "test_file_scan_utils",
    linkstatic = True,
    deps = [":file_scan_cases", "//unittest/sql:test_error_name_stub", "//src/oblib:oblib_test_runtime"],
    target_compatible_with = ["@platforms//os:linux"],
)
