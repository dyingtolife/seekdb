package(default_testonly = True)

cc_library(
    name = "file_scan_cases",
    srcs = ["test_file_scan_utils.cpp"],
    alwayslink = True,
    deps = [
        "//src/oblib:oblib_unit_test_internal_headers",
        "//src/sql:file_scan_test_objects",
        "//src/sql:sql_runtime_interface",
        "//bazel/third_party:gtest",
