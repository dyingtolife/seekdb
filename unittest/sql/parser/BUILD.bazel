load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:defs.bzl", "cc_library")

package(default_testonly = True)

# The C parser (src/sql/parser/parse_node.c) references
# check_stack_overflow_c(), which server builds resolve from
# src/sql/ob_sql_utils.cpp (sql_runtime). A parser-only test must not link the
# whole SQL runtime, so the symbol is supplied by this testonly stub.
cc_library(
    name = "file_sql_parser_symbol_stubs",
    srcs = ["file_sql_parser_symbol_stubs.cpp"],
    alwayslink = True,
)

cc_library(
    name = "file_sql_parser_cases",
    srcs = ["test_file_sql_parser.cpp"],
    alwayslink = True,
    deps = [
        "//src/oblib:oblib_unit_test_internal_headers",
        "//src/sql/parser:sql_parser_driver",
        "//src/sql/parser:parser_internal_headers",
        "//bazel/third_party:gtest",
    ],
)

cc_test(
    name = "test_file_sql_parser",
    linkstatic = True,
    deps = [
        ":file_sql_parser_cases",
        ":file_sql_parser_symbol_stubs",
        "//unittest/sql:test_error_name_stub",
        "//src/oblib:oblib_test_runtime",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)
