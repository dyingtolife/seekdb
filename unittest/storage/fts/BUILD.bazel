load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:defs.bzl", "cc_library")

package(default_testonly = True)

cc_library(
    name = "fts_stop_word_cases",
    srcs = ["test_fts_stop_word.cpp"],
    alwayslink = True,
    deps = [
        "//bazel/third_party:gtest",
        "//src/storage:fts_test_headers",
    ],
)

cc_test(
    name = "test_fts_stop_word",
    size = "small",
    linkstatic = True,
    # liboceanbase supplies the C++ runtime; select rules_cc's $ORIGIN rpath.
    features = ["-static_cpp_runtime", "-static_link_cpp_runtimes"],
    deps = [
        ":fts_stop_word_cases",
        "//src/observer:liboceanbase",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

cc_library(
    name = "fts_bench_cases",
    srcs = ["test_fts_bench.cpp"],
    alwayslink = True,
    deps = [
        "//bazel/third_party:gtest",
        "//src/storage:fts_test_headers",
    ],
)

cc_test(
    name = "test_fts_bench",
    size = "medium",
    linkstatic = True,
    features = ["-static_cpp_runtime", "-static_link_cpp_runtimes"],
    deps = [
        ":fts_bench_cases",
        "//src/observer:liboceanbase",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)
